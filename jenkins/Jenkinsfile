// Deprecated: use the root Jenkinsfile for backend-only deployments.
// Frontend is deployed via AWS Amplify (see amplify.yml).
pipeline {
agent any

```
environment {
    APP_NAME = "resume-backend"
    CONTAINER_NAME = "resume-backend"
    IMAGE_NAME = "resume-backend"
}

stages {

    stage('Checkout') {
        steps {
            git branch: 'main',
            url: 'https://github.com/Kavinrajsaravanakumar/Smart-Resume-screening-Platform.git'
        }
    }

    stage('Build Docker Image') {
        steps {
            sh '''
                docker build -t ${IMAGE_NAME} backend
            '''
        }
    }

    stage('Stop Old Container') {
        steps {
            sh '''
                docker stop ${CONTAINER_NAME} || true
                docker rm ${CONTAINER_NAME} || true
            '''
        }
    }

    stage('Deploy Container') {
        steps {
            sh '''
                docker run -d \
                  --name ${CONTAINER_NAME} \
                  --restart unless-stopped \
                  -p 5000:5000 \
                  --env-file backend/.env \
                  ${IMAGE_NAME}
            '''
        }
    }

    stage('Health Check') {
        steps {
            sh '''
                sleep 15
                curl -f http://localhost:5000/health
            '''
        }
    }
}

post {

    success {
        echo 'Deployment Successful'
    }

    failure {
        echo 'Deployment Failed'
    }

    always {
        sh 'docker ps -a'
    }
}
```

}
